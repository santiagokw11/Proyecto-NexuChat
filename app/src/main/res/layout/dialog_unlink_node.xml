<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_close"
            app:tint="#F44336"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desvincular Nodo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvUnlinkMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Estás seguro de que deseas olvidar esta cuenta? Esta acción no borrará tus chats, pero deberás registrarte de nuevo para acceder."
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelUnlink"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cornerRadius="12dp"
                android:text="Cancelar"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/text_secondary"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmUnlink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                android:text="Desvincular" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>