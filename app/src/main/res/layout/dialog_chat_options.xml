<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_rounded"
        android:backgroundTint="?android:colorBackground"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvOptionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="4dp"
            android:text="Opciones de Chat"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateGroup"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingVertical="12dp"
            android:text="Crear Grupo con este usuario"
            android:textColor="?android:attr/textColorPrimary"
            app:icon="@android:drawable/ic_menu_add"
            app:iconTint="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditGroup"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingVertical="12dp"
            android:text="Editar Grupo"
            android:textColor="?android:attr/textColorPrimary"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconTint="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPinChat"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingVertical="12dp"
            android:text="Fijar Chat"
            android:textColor="?android:attr/textColorPrimary"
            app:icon="@drawable/ic_pin"
            app:iconTint="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearChat"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingVertical="12dp"
            android:text="Vaciar Historial"
            android:textColor="?android:attr/textColorPrimary"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconTint="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteChat"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingVertical="12dp"
            android:text="Eliminar Chat"
            android:textColor="#F44336"
            app:icon="@drawable/ic_delete"
            app:iconTint="#F44336" />

    </LinearLayout>
</FrameLayout>