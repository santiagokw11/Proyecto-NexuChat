<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?android:colorBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajustes del Grupo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:layout_marginBottom="24dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvGroupAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="60dp"
        app:cardBackgroundColor="#2C2C2C"
        app:cardElevation="4dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivGroupAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#FFFFFF"
                android:alpha="0.7" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/etGroupName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del grupo"
        android:inputType="textCapSentences"
        android:background="@drawable/bg_input_chat"
        android:textColor="?android:textColorPrimary"
        android:padding="16dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:textSize="18sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Participantes"
        android:textSize="14sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddMembers"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Añadir nuevos miembros"
        app:icon="@android:drawable/ic_input_add"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:gravity="start|center_vertical"
        android:paddingStart="0dp"
        app:iconTint="?android:colorAccent"
        android:textColor="?android:textColorPrimary"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoveMembers"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Remover del grupo"
        app:icon="@android:drawable/ic_delete"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:gravity="start|center_vertical"
        android:paddingStart="0dp"
        app:iconTint="#FF5252"
        android:textColor="?android:textColorPrimary"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmEditGroup"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Guardar cambios"
        app:cornerRadius="16dp"
        android:backgroundTint="?android:colorAccent"
        android:textSize="16sp"/>
</LinearLayout>